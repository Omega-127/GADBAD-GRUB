# Local Development:
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
# VITE_DEMO_MODE=true

# Production Deployment (Set in Vercel Dashboard -> Settings -> Environment Variables):
# IMPORTANT: Vite embeds these at BUILD time — redeploy after changing them.
# Root Directory on Vercel must be `client`.
VITE_API_BASE_URL=https://gadbad-grub-server.onrender.com/api
VITE_SOCKET_URL=https://gadbad-grub-server.onrender.com
# Keep true so the race hub can fall back to a local simulator if the API race is missing.
# Set false only when the Render backend is confirmed healthy.
VITE_DEMO_MODE=true
