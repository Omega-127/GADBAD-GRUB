# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Provide MONGODB_URI if using MongoDB. If left empty or MongoDB is unreachable, in-memory store is used automatically.
MONGODB_URI=
USE_IN_MEMORY_DB=true

# Race Simulation Configuration
# Interval in milliseconds for simulator tick (default: 1500ms for demo, faster for tests)
RACE_TICK_INTERVAL_MS=1500
DEMO_MODE=true

# Optional AI Commentary Provider
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
